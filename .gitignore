# =============================================
# SMART POLYHOUSE - .gitignore
# =============================================

# --- SECRETS & ENVIRONMENT VARIABLES (NEVER COMMIT) ---
.env
.env.local
.env.*.local
.env.production
.env.development
*.secret
*.key
service-account*.json
firebase-adminsdk*.json

# --- BUILD OUTPUT (regenerated by npm run build) ---
dist/
dist-ssr/

# --- DEPENDENCIES (regenerated by npm install) ---
node_modules/

# --- VERCEL DEPLOYMENT (local metadata only) ---
.vercel/

# --- VITE CACHE ---
.vite/

# --- EDITOR & OS ---
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- JEST / TESTING ---
coverage/
